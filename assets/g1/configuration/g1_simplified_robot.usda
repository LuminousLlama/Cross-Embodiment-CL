#usda 1.0

# Override the inherited full-G1 Robot Schema lists after unused subtrees are
# deactivated in g1_simplified.  The order is the public manipulation contract.
over "g1_29dof_with_hand_rev_1_0" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Unitree G1 fixed-base waist and right-arm manipulation robot"
    string isaac:namespace = "unitree_g1_simplified"
    token isaac:robotType = "Manipulator"
    rel isaac:physics:robotLinks = [
        </g1_29dof_with_hand_rev_1_0/pelvis>,
        </g1_29dof_with_hand_rev_1_0/waist_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/waist_roll_link>,
        </g1_29dof_with_hand_rev_1_0/torso_link>,
        </g1_29dof_with_hand_rev_1_0/right_shoulder_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/right_shoulder_roll_link>,
        </g1_29dof_with_hand_rev_1_0/right_shoulder_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/right_elbow_link>,
        </g1_29dof_with_hand_rev_1_0/right_wrist_roll_link>,
        </g1_29dof_with_hand_rev_1_0/right_wrist_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/right_wrist_yaw_link>
    ]
    rel isaac:physics:robotJoints = [
        </g1_29dof_with_hand_rev_1_0/joints/waist_yaw_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/waist_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/waist_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_shoulder_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_shoulder_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_shoulder_yaw_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_elbow_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_wrist_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_wrist_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_wrist_yaw_joint>
    ]
}
