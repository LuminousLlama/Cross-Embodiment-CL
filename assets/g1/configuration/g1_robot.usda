#usda 1.0

# Isaac Robot Schema metadata for the complete G1.  This layer deliberately
# contains no geometry, collision, mass, or solver-specific opinions.
over "g1_29dof_with_hand_rev_1_0" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    string isaac:description = "Unitree G1 fixed-base humanoid robot"
    string isaac:namespace = "unitree_g1"
    token isaac:robotType = "Humanoid"
    token isaac:license = "Other"
    string isaac:version = "1.0.0"
    string isaac:source = "Unitree G1"
    string[] isaac:changelog = ["Added Isaac Robot Schema metadata and deterministic link and joint ordering."]

    rel isaac:physics:robotLinks = [
        </g1_29dof_with_hand_rev_1_0/pelvis>,
        </g1_29dof_with_hand_rev_1_0/left_hip_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/left_hip_roll_link>,
        </g1_29dof_with_hand_rev_1_0/left_hip_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/left_knee_link>,
        </g1_29dof_with_hand_rev_1_0/left_ankle_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/left_ankle_roll_link>,
        </g1_29dof_with_hand_rev_1_0/right_hip_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/right_hip_roll_link>,
        </g1_29dof_with_hand_rev_1_0/right_hip_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/right_knee_link>,
        </g1_29dof_with_hand_rev_1_0/right_ankle_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/right_ankle_roll_link>,
        </g1_29dof_with_hand_rev_1_0/waist_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/waist_roll_link>,
        </g1_29dof_with_hand_rev_1_0/torso_link>,
        </g1_29dof_with_hand_rev_1_0/left_shoulder_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/left_shoulder_roll_link>,
        </g1_29dof_with_hand_rev_1_0/left_shoulder_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/left_elbow_link>,
        </g1_29dof_with_hand_rev_1_0/left_wrist_roll_link>,
        </g1_29dof_with_hand_rev_1_0/left_wrist_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/left_wrist_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/right_shoulder_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/right_shoulder_roll_link>,
        </g1_29dof_with_hand_rev_1_0/right_shoulder_yaw_link>,
        </g1_29dof_with_hand_rev_1_0/right_elbow_link>,
        </g1_29dof_with_hand_rev_1_0/right_wrist_roll_link>,
        </g1_29dof_with_hand_rev_1_0/right_wrist_pitch_link>,
        </g1_29dof_with_hand_rev_1_0/right_wrist_yaw_link>
    ]
    rel isaac:physics:robotJoints = [
        </g1_29dof_with_hand_rev_1_0/joints/left_hip_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/left_hip_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/left_hip_yaw_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/left_knee_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/left_ankle_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/left_ankle_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_hip_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_hip_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_hip_yaw_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_knee_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_ankle_pitch_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/right_ankle_roll_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/waist_yaw_joint>,
        </g1_29dof_with_hand_rev_1_0/joints/waist_roll_joint>,
