<robot name="dex3_1_r">
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>

  <mujoco>
    <compiler meshdir="meshes" discardvisual="false"/>
  </mujoco>

  <!-- [CAUTION] uncomment when convert to mujoco -->
  <!-- <link name="world"></link>
  <joint name="floating_base_joint" type="floating">
    <parent link="world"/>
    <child link="right_hand_palm_link"/>
  </joint> -->

  <!--
    Canonical anatomical wrist aligned to this repository's metric MANO
    recording coordinates.  The fixed rotation was calibrated on stratified
    frames from all six source recordings.  It preserves the vendor palm/link
    geometry and is mirrored by its exact inverse in the standalone USD.
    Lightning-Grasp and Isaac continue to use right_hand_palm_link as the
    physical candidate/base body.
  -->
  <link name="right_hand_wrist_link"/>
  <joint name="right_hand_wrist_to_palm_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 -1.3526301702956054 -0.9599310885968813"/>
    <parent link="right_hand_wrist_link"/>
    <child link="right_hand_palm_link"/>
  </joint>

  <!-- Canonical physical palm and G1 attachment frame. -->
  <link name="right_hand_palm_link">
    <inertial>
      <origin xyz="0.06214634836 0.00050869656 -0.00058171093" rpy="0 0 0"/>
      <mass value="0.37283854"/>
      <inertia ixx="0.00027535181027" ixy="0.00001595519465" ixz="-0.00000242161890" iyy="0.00053951827219" iyz="0.00000042279435" izz="0.00039623390907"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/right_hand_palm_link.STL"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision name="right_hand_palm_link_hull_0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision_hulls/right_hand_palm_link_hull_0.obj" scale="1 1 1"/>
      </geometry>
    </collision>
    <collision name="right_hand_palm_link_hull_1">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision_hulls/right_hand_palm_link_hull_1.obj" scale="1 1 1"/>
      </geometry>
    </collision>
    <collision name="right_hand_palm_link_hull_2">
