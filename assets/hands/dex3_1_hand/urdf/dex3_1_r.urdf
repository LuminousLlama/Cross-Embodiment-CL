  <!--
    Massless surface frames used as DexPilot fingertip targets.

    The distal link origins coincide with the final revolute joints, not the
    rounded fingertip surfaces.  These translations were measured from the STL
    geometry at the distal surface with zero lateral coordinate.  Keep these
    transforms identical to the corresponding Xforms in unitree_dex3_1.usda.
  -->
  <link name="right_hand_thumb_tip_head"/>
  <joint name="right_hand_thumb_tip_joint" type="fixed">
    <parent link="right_hand_thumb_2_link"/>
    <child link="right_hand_thumb_tip_head"/>
    <origin xyz="-0.0027940843594125744 0.05196166944883709 0" rpy="0 0 0"/>
  </joint>

  <link name="right_hand_index_tip_head"/>
  <joint name="right_hand_index_tip_joint" type="fixed">
    <parent link="right_hand_index_1_link"/>
    <child link="right_hand_index_tip_head"/>
    <origin xyz="0.05196166944883709 -0.0027940843594125744 0" rpy="0 0 0"/>
  </joint>

  <link name="right_hand_middle_tip_head"/>
  <joint name="right_hand_middle_tip_joint" type="fixed">
    <parent link="right_hand_middle_1_link"/>
    <child link="right_hand_middle_tip_head"/>
    <origin xyz="0.05196166944883709 -0.0027940843594125744 0" rpy="0 0 0"/>
  </joint>
