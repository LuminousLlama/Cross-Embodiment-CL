#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dex3_1_r"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "dex3_1_r" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "right_hand_thumb_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_middle_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_index_0_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_wrist_to_palm_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_thumb_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_thumb_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_middle_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_hand_index_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "right_hand_wrist_link"
        {
            over "right_hand_palm_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_hand_thumb_0_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_hand_thumb_1_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_hand_thumb_2_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_hand_thumb_tip_head" (
                                prepend apiSchemas = ["IsaacSiteAPI"]
                            )
                            {
                            }
                        }
                    }
                }

                over "right_hand_middle_0_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_hand_middle_1_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_hand_middle_tip_head" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }

                over "right_hand_index_0_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_hand_index_1_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_hand_index_tip_head" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}
