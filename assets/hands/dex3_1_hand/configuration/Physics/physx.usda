#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dex3_1_r"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "dex3_1_r"
{
    over "Physics"
    {
        over "right_hand_thumb_0_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }

        over "right_hand_thumb_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }

        over "right_hand_thumb_2_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }

        over "right_hand_middle_0_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }

        over "right_hand_middle_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }

        over "right_hand_index_0_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }

        over "right_hand_index_1_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:armature = 0.001
        }
    }

    over "Geometry"
    {
        over "right_hand_wrist_link"
        {
            over "right_hand_palm_link" (
                prepend apiSchemas = ["PhysxArticulationAPI"]
            )
            {
                bool physxArticulation:enabledSelfCollisions = 1
            }
        }
    }
}
