        def MjcActuator "right_index_1_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, -0.1745329201221466, -0.01745329238474369, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 6
            uniform double mjc:forceRange:min = -6
            uniform double[] mjc:gainPrm = [0.1745329201221466, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            append rel mjc:target = </inspire_hand_right/Physics/right_index_1_joint>
        }

