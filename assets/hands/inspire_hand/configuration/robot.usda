#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "inspire_hand_right"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "inspire_hand_right" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "right_index_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_middle_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ring_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_little_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_1_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_index_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_middle_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ring_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_little_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_2_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_3_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thumb_4_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "inspire_hand_base"
        {
            over "hand_base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_index_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_index_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "index_tip" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }

                over "right_middle_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_middle_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "middle_tip" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }

                over "right_ring_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_ring_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "ring_tip" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }

                over "right_little_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_little_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "little_tip" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }

                over "right_thumb_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_thumb_2" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_thumb_3" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_thumb_4" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "thumb_tip" (
                                    prepend apiSchemas = ["IsaacSiteAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
