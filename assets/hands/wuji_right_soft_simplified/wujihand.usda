def Xform "wujihand_right" (
    variants = {
        string Physics = "PhysX"
        string Robot = "Robot"
        string Sensor = "Sensors"
    }
    prepend variantSets = ["Physics", "Sensor", "Robot"]
)
{
    variantSet "Physics" = {
        "None" (
            prepend references = @./configuration/wujihand_base.usd@
        ) {
            over "joints" (
                active = false
            )
            {
            }

        }
        "PhysX" (
            prepend payload = @./configuration/wujihand_physics.usd@
        ) {
            # Keep the authored position-drive target within its USD joint limits.
            over "joints"
            {
                over "right_finger1_joint1"
                {
                    float drive:angular:physics:targetPosition = 2.7215493
                }
            }

            # Newton requires concrete collision geometry.  Replace the legacy
            # generated collision branches with convex-hull proxies referencing
            # the existing simplified mesh for every rigid link.
            over "right_palm_link"
            {
                # Account for the missing fixed hand/mount mass on the palm. Scale the
                # principal inertia with mass as a same-geometry density approximation.
                float3 physics:diagonalInertia = (0.00033229785, 0.00022650342, 0.00013731726)
                float physics:mass = 0.39953

                over "collisions" (
                    active = false
                )
                {
                }
                def Xform "newton_collision" (
                    prepend references = </wujihand_right/right_palm_link/visuals/right_palm_link/node_STL_BINARY_>
                )
                {
                    over "mesh" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        token physics:approximation = "convexHull"
                    }
                }
            }
            over "right_finger1_link1"
            {
                over "collisions" (
                    active = false
                )
                {
                    over "mesh_0" (active = false) {}
                    over "mesh_1" (active = false) {}
                    over "mesh_2" (active = false) {}
                    def Capsule "physx_newton_capsule" (
                        prepend apiSchemas = ["PhysicsCollisionAPI"]
                    )
                    {
                        uniform token axis = "Z"
                        double height = 0.007259720005095005
                        double radius = 0.00615197978913784
                        double3 xformOp:translate = (0, 0, 0.008279119618237019)
                        quatf xformOp:orient = (1, 0, 0, 0)
                        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
